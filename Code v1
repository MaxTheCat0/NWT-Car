void setup(){
pinMode(4,OUTPUT);//TRIG
pinMode(5,INPUT);//ECHO

pinMode(6,OUTPUT);
pinMode(7,OUTPUT);
pinMode(8,OUTPUT);
pinMode(9,OUTPUT);

Serial.begin(9600);

}

void Stop(){
digitalWrite(6,LOW);
digitalWrite(7,LOW);
digitalWrite(8,LOW);
digitalWrite(9,LOW);

}


void Vor(){
digitalWrite(6,LOW);
digitalWrite(7,HIGH);
digitalWrite(8,HIGH);
digitalWrite(9,LOW);


}
void loop(){
infrarot sensor 

digitalWrite(4, LOW);
delay(2);
digitalWrite(4, HIGH);
delayMicroseconds(10);
digitalWrite(4, LOW);
long duration = pulseIn(5, HIGH);
distance = duration * 0.034 / 2; 
Serial.print(distance);
if(distance < 21){
Stop();
} else {
Vor();
}



}

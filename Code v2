long duration; 
int distance;
int i1 = 5;
int i2 = 6;
int i3 = 9;
int i4 = 10;



void setup(){
pinMode(4,OUTPUT);//TRIG
pinMode(2,INPUT);//ECHO

pinMode(i1,OUTPUT);
pinMode(i2,OUTPUT);
pinMode(i3,OUTPUT);
pinMode(i4,OUTPUT);

pinMode(A1,INPUT);
Serial.begin(9600);

}



void loop(){
int IRValue = analogRead(A1);
  if (IRValue < 300) {
    analogWrite(i1,0);
    analogWrite(i2,100);
    analogWrite(i3,0);
    analogWrite(i4,100);
  }  
   
   if (IRValue > 300) {
    analogWrite(i1,0);
    analogWrite(i2,0);
    analogWrite(i3,0);
    analogWrite(i4,0);
  }  


digitalWrite(4,HIGH);
delayMicroseconds(10);
digitalWrite(4,LOW);
duration = pulseIn(2,HIGH);
distance = duration *0.038/2; 
Serial.println(distance);
if(distance < 31){
analogWrite(i1,0);
analogWrite(i2,0);
analogWrite(i3,0);
analogWrite(i4,0);
} else {
analogWrite(i1,0);
analogWrite(i2,100);
analogWrite(i3,0);
analogWrite(i4,100);
}



}
